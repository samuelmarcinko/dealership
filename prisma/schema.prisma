generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  MANAGER
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  CNG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum BodyType {
  SEDAN
  HATCHBACK
  ESTATE
  SUV
  COUPE
  CONVERTIBLE
  VAN
  PICKUP
  OTHER
}

enum CustomerType {
  PERSON
  COMPANY
}

// Kedy sa dokument používa: pri prevzatí vozidla do komisie (s komitentom),
// pri predaji (s kupujúcim), alebo v oboch prípadoch.
enum DocumentContext {
  INTAKE
  SALE
  BOTH
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id                 String              @id @default(cuid())
  type               CustomerType        @default(PERSON)
  // Fyzická osoba
  firstName          String?
  lastName           String?
  // Firma / Živnostník
  companyName        String?
  ico                String?
  dic                String?
  icDph              String?
  // Spoločné
  phone              String?
  email              String?
  address            String?             @db.Text
  note               String?             @db.Text
  // Údaje pre zmluvy
  birthDate          DateTime?
  idCardNumber       String?
  bankAccount        String?
  isConsignor        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vehicles           Vehicle[]           @relation("VehicleBuyer")
  consignedVehicles  Vehicle[]           @relation("VehicleConsignor")
  generatedDocuments GeneratedDocument[]

  @@map("customers")
}

model Vehicle {
  id                     String              @id @default(cuid())
  title                  String
  make                   String
  model                  String
  variant                String?
  year                   Int
  price                  Decimal             @db.Decimal(12, 2)
  salePrice              Decimal?            @db.Decimal(12, 2)
  mileage                Int
  fuelType               FuelType
  transmission           TransmissionType
  engineCapacity         Int?
  power                  Int?
  color                  String?
  bodyType               BodyType?
  doors                  Int?
  seats                  Int?
  gears                  Int?
  description            String?             @db.Text
  features               String[]
  safetyFeatures         String[]            @default([])
  comfortFeatures        String[]            @default([])
  multimediaFeatures     String[]            @default([])
  exteriorFeatures       String[]            @default([])
  otherFeatures          String[]            @default([])
  evFeatures             String[]            @default([])
  vin                    String?
  // Údaje pre zmluvy
  licensePlate           String?
  firstRegistration      DateTime?
  registrationDocNumber  String?
  declaredMileage        Int?
  driveType              String?
  emissionStandard       String?
  externalUrl            String?
  extraParams            Json?
  stkMonth               Int?
  stkYear                Int?
  ekMonth                Int?
  ekYear                 Int?
  slug                   String?             @unique
  status                 VehicleStatus       @default(AVAILABLE)
  externalId             String?             @unique
  importedAt             DateTime?
  // Predaj
  soldAt                 DateTime?
  soldPrice              Decimal?            @db.Decimal(12, 2)
  soldNote               String?             @db.Text
  buyer                  Customer?           @relation("VehicleBuyer", fields: [buyerId], references: [id])
  buyerId                String?
  // Komisný predaj
  isConsignment          Boolean             @default(false)
  consignorId            String?
  consignor              Customer?           @relation("VehicleConsignor", fields: [consignorId], references: [id], onDelete: SetNull)
  commissionRate         Decimal?            @db.Decimal(5, 2)
  commissionAmount       Decimal?            @db.Decimal(12, 2)
  customCategoryFeatures Json                @default("{}")
  defects                String[]            @default([])
  images                 VehicleImage[]
  videos                 VehicleVideo[]
  generatedDocuments     GeneratedDocument[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@map("vehicles")
}

model VehicleVideo {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("vehicle_videos")
}

model CustomEquipmentCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("Wrench")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("custom_equipment_categories")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("vehicle_images")
}

model DocumentTemplate {
  id           String          @id @default(cuid())
  name         String
  description  String?
  // Telo zmluvy ako HTML so zástupnými premennými {klient_meno}
  content      String          @db.Text
  context      DocumentContext @default(SALE)
  customerType CustomerType? // null = pre všetkých
  // Polia, ktoré sa dopĺňajú ručne pri generovaní (provízia, počet kľúčov…)
  customFields Json            @default("[]")
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  generated GeneratedDocument[]

  @@map("document_templates")
}

// Archív vygenerovaných dokumentov – uchováva finálne znenie vrátane
// úprav, ktoré používateľ urobil pred tlačou.
model GeneratedDocument {
  id           String            @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  templateId   String?
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName String
  content      String            @db.Text
  fieldValues  Json              @default("{}")
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())

  @@index([vehicleId])
  @@map("generated_documents")
}

model EquipmentItem {
  id          String   @id @default(cuid())
  name        String
  category    String // SAFETY | COMFORT | MULTIMEDIA | EXTERIOR | OTHER | EV
  subcategory String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("equipment_items")
}

model MediaFile {
  id         String   @id @default(cuid())
  url        String
  filePath   String
  filename   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())

  @@map("media_files")
}

model TenantSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_settings")
}

model CustomPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        String   @db.Text
  isPublished    Boolean  @default(false)
  showInNav      Boolean  @default(false)
  navOrder       Int      @default(0)
  seoTitle       String?
  seoDescription String?  @db.Text
  ogImage        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("custom_pages")
}

model VehicleView {
  id        String   @id @default(cuid())
  vehicleId String
  ip        String   @default("")
  source    String   @default("direct") // direct | google | facebook | instagram | internal | other
  viewedAt  DateTime @default(now())

  @@index([vehicleId, ip])
  @@index([viewedAt])
  @@map("vehicle_views")
}
